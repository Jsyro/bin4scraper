{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "System.Net.Http.HttpClient": "Warning",
      "Polly": "Warning"
    },
    "Console": {
      "FormatterName": "simple",
      "FormatterOptions": { "SingleLine": true, "TimestampFormat": "yyyy-MM-dd HH:mm:ss " }
    }
  },
  "AllowedHosts": "*",
  "Scraper": {
    "Enabled": true,
    "FeatureUrl": "https://bin4burgerlounge.com/monthly-features/",
    "Categories": "Burger",
    "Schedule": "0 9 * * *",
    "TimeZone": "America/Vancouver",
    "NotifyOnFirstRun": true,
    "RetryDelayMinutes": 60,
    "SnapshotRetention": 30
  },
  "Storage": {
    "DataDirectory": "data"
  },
  "Sms": {
    "Provider": "Console",
    "DefaultCountryCode": "1",
    "MaxAttempts": 3,
    "DelayBetweenMessagesMs": 1000,
    "AdminPhone": "",
    "FailureAlertThreshold": 3,
    "Textbelt": {
      "Key": "",
      "TestMode": false
    },
    "Twilio": {
      "AccountSid": "",
      "AuthToken": "",
      "From": ""
    }
  },
  "Ui": {
    "Username": "admin",
    "Password": ""
  }
}
