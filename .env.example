# Copy to .env (never commit .env) and fill in. Used by `docker compose`.

# Console = dry run (log only), Textbelt or Twilio = real SMS
Sms__Provider=Console

# Textbelt (https://textbelt.com). TestMode=true validates the key without sending or using quota.
Sms__Textbelt__Key=
Sms__Textbelt__TestMode=false

# Twilio (https://twilio.com)
Sms__Twilio__AccountSid=
Sms__Twilio__AuthToken=
Sms__Twilio__From=

# Optional: texted after repeated check failures
Sms__AdminPhone=

# What to send and when
Scraper__Categories=Burger
Scraper__Schedule=0 9 * * *
Scraper__TimeZone=America/Vancouver
TZ=America/Vancouver

# Optional: set to require a login for the web UI (username defaults to admin)
Ui__Password=
